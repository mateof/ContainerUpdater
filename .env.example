# Copia este fichero a .env junto al docker-compose.yml.

# Clave maestra que cifra las credenciales de registry. 32 bytes en base64.
# Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# GUARDA UNA COPIA FUERA DEL NAS. Si la pierdes, las credenciales guardadas son
# irrecuperables: la aplicacion arrancara igual y seguira vigilando los
# registries publicos, pero tendras que volver a introducir las privadas.
CU_ENCRYPTION_KEY=

# Cuenta inicial. Solo se usan en el primer arranque, cuando aun no hay ningun
# usuario. Se te pedira cambiar la contrasena al entrar, porque este fichero
# queda en disco y en el inspect del contenedor.
#
# Si las dejas vacias, la aplicacion genera una contrasena y la escribe UNA VEZ
# en los logs:  docker logs container-updater
CU_ADMIN_USER=admin
CU_ADMIN_PASSWORD=

# Bot de Telegram (opcional). Crealo con @BotFather.
# Sin token, la aplicacion funciona igual y solo se pierde el bot.
CU_TELEGRAM_BOT_TOKEN=
