# Copia este fichero a .env junto al docker-compose.yml y rellena lo que falte.
# El .env NO se sube al repositorio (esta en .gitignore).

# ---------------------------------------------------------------------------
# Obligatorio
# ---------------------------------------------------------------------------

# Clave maestra que cifra las credenciales de registry. 32 bytes en base64.
# Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# GUARDA UNA COPIA FUERA DEL NAS. Si la pierdes, las credenciales guardadas son
# irrecuperables: la aplicacion arrancara igual y seguira vigilando los
# registries publicos, pero tendras que volver a introducir las privadas.
CU_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Cuenta inicial (solo se usa en el primer arranque)
# ---------------------------------------------------------------------------

# Se te pedira cambiar la contrasena al entrar, porque este fichero queda en
# disco y es visible en el inspect del contenedor.
#
# Si dejas la contrasena vacia, la aplicacion genera una y la escribe UNA VEZ en
# los logs:  docker logs container-updater
CU_ADMIN_USER=admin
CU_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Telegram (opcional)
# ---------------------------------------------------------------------------

# Crea el bot con @BotFather. Sin token la aplicacion funciona igual y lo unico
# que se pierde es el bot.
#
# Nadie puede usarlo hasta que lo autorices: desde Ajustes se genera un codigo
# de un solo uso que caduca en 10 minutos.
CU_TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Ajustes opcionales
# ---------------------------------------------------------------------------

# Zona horaria, para que las horas del panel y el cron cuadren.
TZ=Europe/Madrid

# Idioma por defecto de la interfaz y del bot: es | en
CU_DEFAULT_LOCALE=es

# Cada cuanto se comprueban las actualizaciones (cron de 5 campos).
# Por defecto cada 6 horas: mas a menudo despierta los discos del NAS sin que
# nadie publique imagenes a esa velocidad.
CU_CHECK_CRON=0 */6 * * *

# Carpetas donde viven tus proyectos de Container Manager. Acepta lista
# separada por comas si los tienes en varios volumenes.
# Tiene que coincidir con lo que montes en el docker-compose.yml.
CU_COMPOSE_ROOTS=/volume1/docker

# Activalo SOLO si accedes por HTTPS (por ejemplo tras el proxy inverso de DSM).
# En una LAN por HTTP plano, una cookie Secure no se envia y el login parece no
# hacer nada, que es un sintoma dificil de diagnosticar.
# CU_SECURE_COOKIES=1

# Nivel de detalle de los logs: fatal | error | warn | info | debug | trace
# CU_LOG_LEVEL=info
